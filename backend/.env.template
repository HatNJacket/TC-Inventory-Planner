# TC Inventory Planner - Environment Variables
# Copy to .env and fill in values

# Shopify API
SHOPIFY_STORE=telescopes-canada
SHOPIFY_API_VERSION=2025-01
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# Azure SQL (TC-dedicated server)
AZURE_SQL_SERVER=telcansql.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USER=your-username
AZURE_SQL_PASSWORD=your-password

# Auth
TC_PLANNER_AUTH_TOKEN=your-secret-token-here

# Inventory Planner by Sage (for import only)
IP_API_KEY=your-inventory-planner-api-key
IP_ACCOUNT_ID=a10720

# Email (Azure Communication Services)
ACS_CONNECTION_STRING=endpoint=https://tc-communications.canada.communication.azure.com/;accesskey=your-key
PO_EMAIL_FROM=DoNotReply@your-guid.azurecomm.net
PO_EMAIL_TO=steve@telescopescanada.ca

# Forecasting defaults
DEFAULT_LEAD_TIME_DAYS=14
PLANNING_HORIZON_DAYS=30
SAFETY_STOCK_DAYS=7
SALES_HISTORY_MONTHS=12
