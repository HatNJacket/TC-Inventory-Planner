# --- Secrets -------------------------------------------------------------
# backend/.env holds the live Shopify token, Azure SQL password, SendGrid key
# and ACS connection string. Never commit it. Use backend/.env.template as the
# checked-in reference and copy it to backend/.env locally.
.env
.env.*
!.env.template
local.settings.json
*.pem
*.key
*.pfx
service_account*.json

# --- Dependencies --------------------------------------------------------
node_modules/
.venv/
venv/
.scratch_venv/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Build output --------------------------------------------------------
# backend/static/ is the Vite bundle, generated from frontend/src by
# `cd frontend && npm run build`. It is regenerated on every deploy (see
# CLAUDE.md), so committing it would produce a large conflicting diff each
# time. Run the build before `az acr build` — the Dockerfile COPYs it in.
backend/static/
dist/
build/

# --- Editor / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Claude Code ---------------------------------------------------------
# Machine-local permission allowlist; CLAUDE.md is committed deliberately.
.claude/settings.local.json

# --- Local-run secrets ---------------------------------------------------
# setup_env.py is generated by `py run_local.py --make-setup-script` with the
# LIVE settings built in; it is handed out privately, never committed.
setup_env.py

# --- Shipping local runtime state (moves to Azure SQL in a later phase) ---
backend/app/data/shipping_carton_inventory.json
backend/app/data/shipping_packing_history.json
backend/app/data/shipping_users.json
